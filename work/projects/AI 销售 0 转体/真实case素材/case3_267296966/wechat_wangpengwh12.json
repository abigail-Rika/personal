[{"senderRemoteId": "7881302649004601", "receiverRemoteId": "1688857665876682", "messageRemoteId": "1090741", "content": {"messageType": 1011, "flag": 16777216, "senderName": null, "time": 0, "systemMessageType": 0, "content": "你已添加了晓娜，现在可以开始聊天了。", "contentType": "SYSTEM"}, "status": 1, "createdTime": 1777113385, "msgSource": 0}, {"senderRemoteId": "7881302649004601", "receiverRemoteId": "1688857665876682", "messageRemoteId": "1090739", "content": {"messageType": 1011, "flag": 16777216, "senderName": null, "time": 0, "systemMessageType": 0, "content": "以上是打招呼内容", "contentType": "SYSTEM"}, "status": 1, "createdTime": 1777113385, "msgSource": 0}, {"senderRemoteId": "7881302649004601", "receiverRemoteId": "1688857665876682", "messageRemoteId": "1090737", "content": {"messageType": 2, "flag": 16777216, "senderName": null, "time": 0, "quoteMsgRemoteId": 0, "content": "我是晓娜", "ats": [], "contentType": "TEXT"}, "status": 1, "createdTime": 1777113385, "msgSource": 1}, {"senderRemoteId": "1688857665876682", "receiverRemoteId": "7881302649004601", "messageRemoteId": "1090745", "content": {"messageType": 0, "flag": 16777216, "senderName": null, "time": 0, "quoteMsgRemoteId": 0, "content": "🤝您好，我是您在海豚ai学正式版会员的自习助理，之后孩子在海豚的学习就是我来负责了，在海豚自习遇到相关的使用问题，可以联系我！\n\n👇为了后续跟您沟通更加方便，请您提供以下信息：\n1.【报名手机号】：\n2.【孩子姓名】：\n\n 💓另外为了给孩子更有针对性的服务，给您更有效的建议，后面会给您发送一份问卷，麻烦您及时查看微信填写哦[握手]~", "ats": [], "contentType": "TEXT"}, "status": 1, "createdTime": 1777113386, "msgSource": 1}, {"senderRemoteId": "1688857665876682", "receiverRemoteId": "7881302649004601", "messageRemoteId": "1090843", "content": {"messageType": 2, "flag": 16777216, "senderName": null, "time": 0, "quoteMsgRemoteId": 0, "content": "您是家长还是学生呀", "ats": [], "contentType": "TEXT"}, "status": 1, "createdTime": 1777114195, "msgSource": 1}, {"senderRemoteId": "7881302649004601", "receiverRemoteId": "1688857665876682", "messageRemoteId": "1090849", "content": {"messageType": 2, "flag": 16777216, "senderName": null, "time": 0, "quoteMsgRemoteId":